vec3 rayTrace(inout vec3 refRayOrigin, inout vec3 refRayDirection, inout vec4 ref) {
	vec3 color = vec3(0.f);
	uint shapeHit = 0;
	vec2 uv;
	float t = RayMarch(refRayOrigin, refRayDirection, shapeHit);

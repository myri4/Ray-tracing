	if (t < kInfinity) {
		vec3 p0 = refRayOrigin + t * refRayDirection;

		//vec3 uvw = vec3(uv, 1.f - uv.x - uv.y);
		//vec2 texCoords = rtLerp(uvw, texCoord[0], texCoord[1], texCoord[2]);

